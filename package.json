{
  "name": "apartment-investment-calculator",
  "version": "1.0.0",
  "description": "מחשבון השקעות נדל\"ן",
  "main": "index.js",
  "scripts": {
    "start": "npm run start:server",
    "client": "cd client && npm start",
    "server": "cd server && npm run dev",
    "start:server": "cd server && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "copy-data": "node copy-mortgage-data.js",
    "postinstall": "npm run copy-data",
    "build": "cd client && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup": "node setup-env.js && npm run copy-data",
    "dev:win": "concurrently \"cd server && npm run dev\" \"cd client && npm start\"",
    "server:win": "cd server && npm run dev",
    "fix-src": "node fix-src.js"
  },
  "keywords": [
    "real-estate",
    "investment",
    "calculator"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "chart.js": "^4.3.0",
    "concurrently": "^8.2.1",
    "mongoose": "^8.15.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.15",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
